    characterSetSelectionMode: 7
    characterSequence: "\u9234\u9234\u9418\u6D3B\u751F\u751F\u7684\u9B27\u9418\u4F60\u770B\u904E\u55CE\uFF1F\u523A\u8033\u7684\u9234\u8072\u548C\u4E0D\u65B7\u6D41\u901D\u7684\u5206\u79D2\uFF0C\u53EB\u9192\u5167\u5FC3\u6DF1\u8655\u90A3\u500B\u300C\u4E0D\u60F3\u4E0A\u5B78\u300D\u7684\u9748\u9B42\u3002\u8C93\u6B7B\u795E\u6563\u767C\u8457\u53E3\u6C34\u8207\u8C93\u8349\u6DF7\u548C\u7684\u7368\u7279\u6C23\u5473\uFF0C\u9084\u662F\u7DCA\u7DCA\u63E1\u8457\u4E00\u628A\u4E0D\u77E5\u9053\u54EA\u4F86\u7684\u86CB\u7CD5\u53C9\u5B50\u2026\u2026\uFF1F\u770B\u8D77\u4F86\u8A6D\u7570\u53C8\u53EF\u6190\u7684\u6563\u767C\u8457\u53E3\u6C34\u8207\u8C93\u8349\u6DF7\u548C\u7684\u7368\u7279\u6C23\u5473\uFF0C\u9084\u662F\u7DCA\u7DCA\u63E1\u8457\u4E00\u628A\u4E0D\u77E5\u9053\u54EA\u4F86\u7684\u86CB\u7CD5\u53C9\u5B50\u2026\u2026\uFF1F\u8ACB\u9EDE\u64CA\u4E00\u500B\u73A9\u5BB6\u982D\u50CF\u4EE5\u4F7F\u7528\u8C93\u6280\u80FD\u8ACB\u9EDE\u64CA\u4E00\u500B\u73A9\u5BB6\u982D\u50CF\u8ACB\u9EDE\u64CA\u4E00\u500B\u6575\u4EBA\u76EE\u6A19
      4\u770B\u8D77\u4F86\u8A6D\u7570\u53C8\u53EF\u6190\u7684\u9577\u689D\u5F62\u8C93\u73A9\u5076\uFF0C\u5F8C\u9838\u90E8\u5206\u54AC\u50B7\u7279\u5225\u660E\u986F\uFF0C\u6FC0\u70C8\u6230\u9B25\u4E2D\u4F9D\u7136\u80FD\u653B\u64CA\u751F\u7269\u7684\u5F31\u9EDE\uFF0C\u771F\u662F\u96BB\u8070\u660E\u7684\u5DF2\u9078\u64C7\u76EE\u6A19\u5C0F\u8C93\u54AA\u3002\u5636\u5636\u86C7\u8EDF\u7DBF\u7DBF\u8DDF\u4ED6\u5C0D\u6230\u6642\uFF0C\u7E3D\u662F\u80FD\u807D\u5230\u4E00\u4E9B\u547B\u541F\u5F98\u5F8A\u5728\u8033\u908A\uFF0C\u8AAA\u8457\u300C\u5443\u5443\u2026\u2026\u55DA\u62B1\u4F4F\u6575\u65B9\uFF0C\u4F7F\u51FA\u6700\u5F37\u653B\u64CA\u5154\u5B50\u8E39\u55DA\u54C7\u554A\u554A\u554A\uFF01\u4E0D\u60F3\u8D77\u5E8A\u554A\uFF01\uFF01\uFF01\u300D\u4F60\u8D0F\u5F97\u4E86\u6230\u9B25!\u4F60\u8F38\u4E86...\u9003\u8DD1\u6210\u529F\u91CE\u751F\u7684\u6575\u4EBA\u5011\u51FA\u73FE\u4E86\u73A9\u5BB6\u56DE\u5408:\u7121\u6548\u7684\u76EE\u6A19\uFF0C\u8ACB\u9EDE\u64CA\u4E00\u500B\u5B58\u6D3B\u7684\u76EE\u6A19\u8ACB\u9078\u64C7\u4E00\u500B\u5B58\u6D3B\u7684\u6280\u80FD\u7DCA\u7E2E\u6210\u4E00\u5718\uFF0C\u4F7F\u6575\u4EBA\u627E\u4E0D\u5230\u7E2B\u9699\u653B\u64CA
      {skillName} \u6B63\u8ACB\u5148\u9EDE\u64CA\u4E00\u500B\u76EE\u6A19\u5B8C\u6210\u6280\u80FD\u9078\u64C7\u5728\u51B7\u537B\u4E2D\uFF0C\u5269\u9918
      {skillCooldowns[cooldownKey]} \u56DE\u5408\uFF01\u73A9\u5BB6\u76EE\u6A19\u9078\u64C7\u4E86\u6280\u9078\u64C7\u4E86\u6280\u80FD
      4\u80FD\u8ACB\u81F3\u5C11\u70BA\u4E00\u540D\u73A9\u5BB6\u9078\u64C7\u4E00\u500B\u6280\u80FD
      1\u9078\u64C7\u4E86\u6280\u80FD\u9078\u64C7\u4E86\u6280\u80FD\u8ACB\u9EDE\u64CA\u4E00\u500B\u6575\u4EBA\u76EE\u6A19\u4EE5\u4F7F\u7528\u6280\u80FD\u6B63\u5728\u51B7\u537B\u4E2D\uFF0C\u5269\u9918
      3\u65BD\u5C55\u9B54\u6CD5\uFF0C\u63D0\u5347\u5176\u653B\u64CA\u529B\u900F\u904E\u6B4C\u8072\u632F\u596E\u58EB\u6C23\uFF0C\u4F7F\u6211\u65B9\u5168\u9AD4\u627F\u53D7\u50B7\u5BB3\u964D\u4F4E
      \u5C07\u8EAB\u4E0A\u7684\u6BDB\u6574\u7406\u597D\uFF0C\u4F7F\u9632\u79A6\u529B\u4E0A\u5347\u9078\u64C7\u4E86\u6280\u80FD\u900F\u904E\u5531\u6B4C\u7D66\u5168\u9AD4\u6575\u4EBA\u9020\u6210\u50B7\u5BB3\"
      5\u5C07\u50B7\u53E3\u9032\u884C\u5305\u7D2E \u5C0D\u64BF\u8D77\u8EAB\u908A\u7684\u6771\u897F\u4E1F\u5411
