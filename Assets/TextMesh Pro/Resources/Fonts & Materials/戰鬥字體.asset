    characterSequence: "\u81A0\u5E36\u62F3\u5957\u767C\u52D5\uFF01\u5C0D {target.unitName}
      \u9020\u6210\u984D\u5916 {extraDamage} \u9EDE\u50B7\u5BB3\u3002\" if (playerUnits[0].equippedGear.Contains(\"\u7A7F\u6234\u5F0F\u7D19\u7BB1\u76D4\u7532\"))\n       
      {\n            dialogueText.text = \"\u56E0\u70BA\u7A7F\u6234\u5F0F\u7D19\u7BB1\u76D4\u7532\uFF0C\u53EA\u80FD\u4F7F\u7528\u6280\u80FD1\uFF01\u8ACB\u9EDE\u64CA\u4E00\u500B\u6575\u4EBA\u76EE\u6A19\uFF01\";\n       
