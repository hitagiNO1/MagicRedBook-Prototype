    characterSequence: "\u4F60\u9EDE\u932F\u4E86!\u6C92\u5728\u6642\u9593\u5167\u9054\u6210\u76EE\u6A19!\u9054\u6210\u76EE\u6A19\u6557\u4F60\u6F0F\u9EDE\u4E86\u9ED1\u584A{self.unitName}
