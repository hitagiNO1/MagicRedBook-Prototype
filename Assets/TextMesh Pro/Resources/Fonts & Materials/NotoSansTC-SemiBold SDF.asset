      .. .. .\u600E\u9EBC\u8B8A\u9019\u6A23\u4E86. .. .. .\u300D\u5E03\u840A\u514B\uFF08\u4F4E\u843D11\uFF09\uFF1A\u300C\u5728\u59B3\u7526\u9192\u4E0D\u4E45\u524D\uFF0C\u5B83\u50CF\u53D7\u4E86\u4EC0\u9EBC\u529B\u91CF\u4E00\u6A23\uFF0C\u4E00\u9663\u767D\u5149\u5F8C\u7A81\u7136\u5347\u7A7A\u7206\u70B8\uFF0C\u5167\u9801\u90FD\u6563\u5230\u56DB\u9762\u516B\u65B9\u4E86\u2026\u2026\u300D\u840A\u83C8\uFF08\u96E3\u904E10\uFF09\uFF1A\u300C\u600E\u9EBC\u6703\u9019\u6A23\u2026\u2026\u300D\u5E8F\u7AE00-3\u3010\u4E3B\u8981\u4EFB\u52D9\uFF1A\u9B54\u6CD5\u66F8\u529F\u80FD\u6559\u5B78\uFF0C\u958B\u59CB\u5C0B\u627E\u9801\u9762\u3011\u9B54\u6CD5\u66F8\u6563\u843D\u56DB\u65B9\u5F8C\uFF0C\u5169\u4EBA\u6B63\u7126\u6025\u5730\u60F3\u8FA6\u6CD5\u6642\uFF0C\u9B54\u6CD5\u66F8\u5FFD\u7136\u7DE9\u7DE9\u98C4\u8D77\uFF0C\u9583\u720D\u8457\u67D4\u548C\u7684\u5149\u8292\uFF0C\u6307\u5F15\u8457\u5169\u4EBA\u524D\u5F80\u796D\u58C7\u7684\u51FA\u53E3\uFF0C\u5149\u8292\u4E0B\uFF0C\u4E00\u5F35\u9B54\u6CD5\u66F8\u7684\u788E\u7247\u8D6B\u7136\u51FA\u73FE\u5728\u5169\u4EBA\u9762\u524D\u3002\u5169\u4EBA\u9054\u6210\u4E86\u5171\u8B58\uFF1A\u7531\u5E03\u840A\u514B\u5E6B\u5FD9\u5C0B\u627E\u5931\u6563\u7684\u9801\u9762\uFF0C\u5F85\u9B54\u6CD5\u66F8\u4FEE\u5FA9\u5F8C\uFF0C\u840A\u83C8\u4FBF\u6703\u966A\u540C\u4ED6\u56DE\u5230\u8C93\u4E4B\u570B\u30020-3-1\u840A\u83C8\uFF08\u96E3\u904E12\uFF09\uFF1A\u300C\u9B54\u6CD5\u7D05\u66F8\u2026\u2026\u300D\u5E03\u840A\u514B\uFF08\u61CA\u60F111\uFF09\uFF1A\u300C\u771F\u7684\u5F88\u62B1\u6B49.
