    characterSetSelectionMode: 7
    characterSequence: "\u5287\u60C5\u6587\u672C\u524D\u60C5\u63D0\u8981\u5F9E\u524D\u2014\u2014\u8C93\u4E4B\u570B\u662F\u500B\u5F31\u8089\u5F37\u98DF\u7684\u5730\u65B9\uFF0C\u5931\u53BB\u7236\u6BCD\u7684\u5E03\u840A\u514B\u5728\u5176\u4E2D\u8271\u96E3\u6C42\u751F\uFF0C\u8C93\u4E4B\u570B\u9593\u6D41\u50B3\u8457\u201D\u516C\u4E3B\u7684\u50B3\u8AAA\u201D\uFF1A\u300C\u5F9E\u524D\u6709\u4F4D\u516C\u4E3B\u65BD\u5C55\u9B54\u6CD5\uFF0C\u8B93\u5927\u5BB6\u4E0D\u518D\u98E2\u9913\uFF0C\u4F46\u5979\u7A81\u7136\u6D88\u5931\uFF0C\u53EA\u7559\u4E0B\u4E86\u4E00\u672C\u9B54\u6CD5\u7D05\u66F8\u300D\uFF0C\u800C\u95DC\u65BC\u516C\u4E3B\u7684\u4E0B\u843D\uFF0C\u6709\u53E5\u50B3\u805E\u8AAA\u300E\u5145\u6EFF\u6069\u60E0\u4E4B\u5730\uFF0C\u8056\u8077\u6C89\u7761\u4E4B\u8655\u3002\u300F\u4E0D\u904E\u6C92\u6709\u4EBA\u77E5\u9053\u9019\u500B\u5730\u65B9\u5728\u54EA\uFF0C\u4E5F\u6C92\u4EBA\u9858\u610F\u63A2\u5C0B\uFF0C\u5E03\u840A\u514B\u610F\u5916\u627E\u5230\u90A3\u672C\u9B54\u6CD5\u7D05\u66F8\uFF0C\u6C7A\u5B9A\u8DDF\u96A8\u8457\u50B3\u805E\u8E0F\u4E0A\u5C0B\u627E\u516C\u4E3B\u7684\u65C5\u7A0B\uFF0C\u6539\u8B8A\u547D\u904B\u3002\u5728\u67D0\u500B\u57CE\u5E02\u7684\u89D2\u843D\u88E1\uFF0C\u6709\u500B\u540D\u70BA\u300C\u8C93\u4E4B\u570B\u300D\u7684\u5730\u65B9\u3002\u90A3\u88E1\u6C92\u6709\u79E9\u5E8F\u6216\u6069\u60E0\uFF0C\u53EA\u6709\u98E2\u9913\u8207\u63A0\u596A\u3002\u4E00\u96BB\u5931\u53BB\u96D9\u89AA\u7684\u5C0F\u9ED1\u8C93\uFF0C\u5728\u9019\u6A23\u7684\u4E16\u754C\u88E1\u5B64\u7368\u7684\u6210\u9577\u3002\u4ED6\u96B1\u85CF\u65BC\u9ED1\u6697\u4E2D\uFF0C\u52AA\u529B\u6399\u624E\u8457\uFF0C\u53EA\u70BA\u6D3B\u4E0B\u53BB\u3002\u300C\u54C8\u2026\u2026\u54C8\u2026\u2026\u300D\u5C0F\u9ED1\u8C93\u6C23\u5598\u5401\u5401\u5730\u5954\u8DD1\u8457\u3002\u5FFD\u7136\uFF0C\u4ED6\u88AB\u4EC0\u9EBC\u6771\u897F\u7D46\u4F4F\uFF0C\u8DCC\u4E86\u4E00\u8DE4\u3002\u300C\u554A\u2014\u2014\uFF01\u300D\u51B0\u51B7\u7684\u5730\u4E0A\uFF0C\u4E00\u9053\u7D05\u8272\u7684\u5FAE\u5149\u6084\u7136\u9583\u720D\u3002\u300C\u9019\u500B\u662F.
      .. .. .\uFF1F\u300D\u90A3\u662F\u4E00\u672C\u9583\u720D\u5FAE\u5149\u7684\u7D05\u66F8\uFF0C\u6563\u767C\u8457\u67D4\u548C\u7684\u5149\u8292\u548C\u795E\u79D8\u6C23\u606F\u3002\u5C0F\u9ED1\u8C93\u4E26\u4E0D\u77E5\u9053\uFF0C\u5F9E\u4ED6\u4F38\u51FA\u722A\u5B50\u89F8\u78B0\u66F8\u672C\u7684\u90A3\u4E00\u523B\u8D77\uFF0C\u4E00\u6BB5\u5947\u5999\u7684\u5192\u96AA\u65C5\u7A0B\u5DF2\u6084\u6084\u5C55\u958B.
      .. .. .\u5728\u65C5\u9014\u7684\u76E1\u982D\uFF0C\u7B49\u5F85\u4ED6\u7684\u4E0D\u53EA\u662F\u7B54\u6848\uFF0C\u800C\u662F\u53E6\u4E00\u500B\u547D\u904B\u9082\u9005\u7684\u958B\u7AEF\u3002\u5E8F\u7AE00-1\u65B0\u624B\u6559\u5B78\u3010\u4E3B\u8981\u9032\u5EA6\uFF1A\u4E86\u89E3\u56DE\u5408\u95DC\u5361\u904B\u4F5C\u3011\u300E\u5145\u6EFF\u6069\u60E0\u4E4B\u5730\uFF0C\u8056\u8077\u6C89\u7761\u4E4B\u8655\u3002\u300F\u6D6A\u8C93\"\u5E03\u840A\u514B\"\u6839\u64DA\u50B3\u8AAA\uFF0C\u4F86\u5230\u4E86\u796D\u58C7\u6240\u5728\u4E4B\u5730\u2014\u2014\u300E\u8349\u6069\u300F\u3002\u4ED6\u548C\u81EA\u5DF1\u7684\u6B66\u5668\u8AC7\u7B11\u9593\uFF0C\u6162\u6162\u5730\u5F9E\u660E\u4EAE\u7684\u68EE\u6797\u8E0F\u5165\u4E86\u5149\u7DDA\u660F\u6697\u4E4B\u8655\uFF0C\u788E\u77F3\u8207\u5EE2\u589F\u4E4B\u4E2D\u7A81\u7136\u51FA\u73FE\u4E86\u602A\u7269\uFF0C\u4E00\u908A\u788E\u5FF5\u8457\u4E00\u908A\u671D\u8457\u5E03\u840A\u514B\u8972\u4F86\u2026\u2026\u597D\u4E0D\u5BB9\u6613\u89E3\u6C7A\u4E86\u7A81\u7136\u8972\u4F86\u7684\u5C0F\u602A\uFF0C\u5E03\u840A\u514B\u5230\u4E86\u4E00\u8655\u50CF\u662F\u796D\u58C7\u7684\u5730\u65B9\u30020-1-1(Timeline\u52D5\u756B1\u6A6B\u79FB\u5C55\u793A\u9019\u500B\u4E16\u754C)\uFF08\u93E1\u982D\u505C\u5728\u4E00\u96BB\u5C0F\u5154\u81EA\u5728\u5730\u8DF3\u4F86\u8DF3\u53BB\uFF09\u5E03\u840A\u514B\uFF08\uFF09\uFF1A\u300C\u4F60\u5011\u77E5\u9053\u55CE\uFF1F\u300D\uFF08\u93E1\u982D\u62C9\u56DE\u8EB2\u5728\u8349\u53E2\u7684\u5E03\u840A\u514B\uFF09\u5E03\u840A\u514B\uFF08\uFF09\uFF1A\u300C\u8070\u660E\u7684\u7375\u4EBA\u2026\u2026\u7E3D\u662F\u85CF\u5728\u6697\u8655\uFF0C\u7136\u5F8C\u2014\u2014\u300D\u5E03\u840A\u514B\uFF08\uFF09\uFF1A\u300C\u78C5\uFF01\uFF01\u4E00\u8209\u885D\u51FA\u53BB\uFF01\u300D(\u5E03\u840A\u514B\u5F9E\u8349\u53E2\u6C96\u51FA\u8972\u64CA\u5154\u5B50\u4F46\u5154\u5B50\u5BDF\u89BA\u9003\u8DD1\u4E86)\u5E03\u840A\u514B\uFF08\u6C23\u5598\u5401\u540115\uFF09\uFF1A\u300C\u53EF\u2026\u2026\u53EF\u60E1\uFF01\u300D\u5E03\u840A\u514B\uFF08\u632F\u4F5C16\uFF09\uFF1A\u300C\u4E0B\u6B21\u4E00\u5B9A\u80FD\u6293\u5230\uFF01\u300D\u5C0F\u5630\uFF08\u5931\u671B2\uFF09\uFF1A\u300C\u5630\u4F30\u2026\u2026\u300D\u5C0F\u55B3\uFF08\u50BB\u50BB5\uFF09\uFF1A\u300C\u55B3\u55B3\uFF1F\u300D\u5C0F\u547C\uFF08\u53EF\u611B3\uFF09\uFF1A\u300C\u54AA\u547C\uFF5E\u300D(\u53EF\u79FB\u52D5)0-1-2\u5E03\u840A\u514B\uFF08\u81EA\u8A00\u81EA\u8A9E12\uFF09\uFF1A\u300C\u8AAA\u8D77\u4F86\u2026\u2026\u96E2\u958B\u5BB6\u9109\u4E5F\u5FEB\u4E00\u5E74\u4E86\uFF0C\u53EF\u9084\u662F\u4E00\u9EDE\u9032\u5C55\u4E5F\u6C92\u6709\u3002\u300D\u5E03\u840A\u514B\uFF08\u4F4E\u982D\u6C89\u601D12\uFF09\uFF1A\u300C\u8349\u6069\u2026\u2026\u9019\u500B\u5730\u65B9\uFF0C\u771F\u7684\u80FD\u627E\u5230\u516C\u4E3B\u55CE\uFF1F\u300D\u5E03\u840A\u514B\uFF08\u6416\u6416\u982D11\uFF09\uFF1A\u300C\u7B97\u4E86\uFF0C\u60F3\u90A3\u9EBC\u591A\u4E5F\u6C92\u7528\u3002\u300D\u5E03\u840A\u514B\uFF08\u632F\u4F5C3\uFF09\uFF1A\u300C\u73FE\u5728\u552F\u4E00\u80FD\u505A\u7684\u5C31\u662F\u627E\u5230\u516C\u4E3B\uFF0C\u8ACB\u5979\u8DDF\u6211\u5011\u8D70\u4E00\u8D9F\u3002\u300D\u65C1\u767D\uFF1A\u300C\uFF08\u5E03\u840A\u514B\u4F4E\u982D\u770B\u5411\u624B\u4E2D\u7684\u9B54\u6CD5\u66F8\uFF0C\u96B1\u96B1\u6563\u767C\u8457\u5FAE\u5F31\u7684\u529B\u91CF\uFF09\u300D\u5E03\u840A\u514B\uFF08\u6B63\u827217\uFF09\uFF1A\u300C\u9019\u4E00\u5B9A\u662F\u4E00\u672C\u771F\u6B63\u7684\u9B54\u6CD5\u66F8\uFF01\u300D\u5E03\u840A\u514B\uFF08\u5606\u6C2312\uFF09\uFF1A\u300C\u53EF\u662F\u6751\u88E1\u7684\u4EBA\u90FD\u4E0D\u80AF\u76F8\u4FE1\u6211\u3002\u300D\u5E03\u840A\u514B\uFF08\u5606\u6C239\uFF09\uFF1A\u300C\u5927\u5BB6\u53EA\u628A\u5B83\u7576\u6210\u4E00\u672C\u7834\u820A\u7684\u66F8\uFF0C\u5C31\u9023\u516C\u4E3B\u7684\u50B3\u8AAA\u4E5F\u88AB\u7576\u6210\u7B11\u8A71\u770B\u5F85.
      .. .. .\u300D\u5C0F\u547C\uFF08\u5B89\u61705\uFF09\uFF1A\u300C\u54AA\u547C\uFF5E\u300D\u5C0F\u55B3\uFF08\u7591\u60D114\uFF09\uFF1A\u300C\u55B3\u55B3\uFF1F\u300D\u5E03\u840A\u514B\uFF08\u82E6\u7B114\uFF09\uFF1A\u300C\u54C8\u54C8\u54C8\u2026\u2026\u9084\u662F\u4F60\u5011\u6700\u61C2\u6211\u3002\u300D\u5C0F\u547C\uFF08\u6B6A\u982D\u7591\u554F1\uFF09\uFF1A\u300C\u54AA\u547C\u2026\u2026\uFF1F\u300D\u5E03\u840A\u514B\uFF08\u9707\u9A5A5\uFF09\uFF1A\u300C\u54A6\uFF1F\u4F60\u554F\u6211\uFF0C\u516C\u4E3B\u7684\u50B3\u8AAA\u662F\u4EC0\u9EBC\uFF1F\u300D\u5E03\u840A\u514B\uFF08\u958B\u61F7\u5927\u7B1113\uFF09\uFF1A\u300C\u54C8\u54C8\u54C8\u54C8\u54C8\uFF5E\u4F60\u5011\u5C45\u7136\u4E0D\u77E5\u9053\uFF01\u300D\u5E03\u840A\u514B\uFF08\u5F97\u610F\u6EFF\u6EFF1\uFF09\uFF1A\u300C\u5F9E\u524D\u554A\uFF0C\u6709\u4F4D\u516C\u4E3B\u4F86\u5230\u4E86\u8C93\u4E4B\u570B\u3002\u300D\u5E03\u840A\u514B\uFF08\u958B\u5FC317\uFF09\uFF1A\u300C\u807D\u8AAA\u5979\u8E0F\u904E\u7684\u571F\u5730\uFF0C\u9023\u77F3\u982D\u90FD\u6703\u9577\u51FA\u7A3B\u7A57\u4F86\u3002\u300D\u5E03\u840A\u514B\uFF0816\uFF09\uFF1A\u300C\u516C\u4E3B\u7684\u6B4C\u8072\u4F7F\u7A3B\u7A57\u98FD\u6EFF\uFF0C\u9B54\u6CD5\u91AB\u767E\u75C5\uFF0C\u5176\u795E\u8E5F\u4E0D\u52DD\u679A\u8209\uFF0C\u7121\u4E0D\u4EE4\u4EBA\u7A31\u5947\u3002\u300D\u5E03\u840A\u514B\uFF08\u773C\u795E\u9583\u958312\uFF09\uFF1A\u300C\u7136\u800C\u5929\u5730\u7121\u5E38\uFF0C\u67D0\u5929\u516C\u4E3B\u5FFD\u7136\u6D88\u8DE1\u7121\u8E64\uFF0C\u53EA\u7559\u4E0B\u4E00\u672C\u9B54\u6CD5\u7D05\u66F8\u8207\u4E00\u53E5\u50B3\u805E\u3002\u300D\u5E03\u840A\u514B\uFF08\u773C\u795E\u9583\u958312\uFF09\uFF1A\u300C\u2014\u2014\u300C\u5145\u6EFF\u6069\u60E0\u4E4B\u5730\uFF0C\u8056\u8005\u9577\u7720\u4E4B\u8655\u300D\u3002\u300D\u5E03\u840A\u514B\uFF08\u5805\u5B9A3\uFF09\uFF1A\u300C\u6240\u4EE5\u6211\u624D\u76F8\u4FE1\u2026\u2026\u53EA\u8981\u627E\u5230\u9019\u500B\u5730\u65B9\uFF0C\u5C31\u80FD\u627E\u5230\u6551\u8D16\u8C93\u4E4B\u570B\u7684\u65B9\u6CD5\uFF01\u300D\u5E03\u840A\u514B\uFF08\u5F97\u610F16\uFF09\uFF1A\u300C\u54FC\u54FC\uFF5E\u6191\u6211IQ180\u7684\u63A8\u7406\uFF0C\u9019\u88E1\u2014\u2014\u8349\u6069\uFF0C\u5C31\u662F\u9810\u8A00\u4E2D\u63D0\u5230\u7684\u5730\u65B9\uFF01\u300D\u5C0F\u5630(\u958B\u5FC33\uFF09\uFF1A\u300C\u5630\u4F30\uFF01\uFF01\u300D\u5C0F\u547C\uFF08\u5FEB\u6A023\uFF09\uFF1A\u300C\u54AA\u547C\uFF5E\uFF01\u300D\u5C0F\u55B3\uFF08\u5FEB\u6A023\uFF09\uFF1A\u300C\u55B3\u55B3\uFF01\u55B3\u55B3\uFF01\u300D0-1-3\u5E03\u840A\u514B\uFF08\u56B4\u80858\uFF09\uFF1A\u300C\u7B49\u7B49\uFF01\u6709\u52D5\u975C\u3002\u300D\u5C0F\u5630\uFF08\u7DCA\u5F352\uFF09\uFF1A\u300C\u5630\u4F30\uFF1F\u300D\u5C0F\u547C\uFF08\u9707\u9A5A4\uFF09\uFF1A\u300C\u54AA\u547C\uFF01\u300D(Timeline\u52D5\u756B2\u521D\u9047\u602A\u7269)\u5E03\u840A\u514B\uFF082\uFF09\uFF1A\u300C\u64CB\u5728\u8DEF\u4E0A\u5462\u2026\u2026\u300D\u5E03\u840A\u514B\uFF083\uFF09\uFF1A\u300C\u770B\u4F86\u514D\u4E0D\u4E86\u4E00\u6230\uFF0C\u6E96\u5099\u4E0A\u4E86\uFF01\u300D\u5C0F\u55B3\uFF08\u5446\u54465\uFF09\uFF1A\u300C\u55B3\uFF1F\u300D(\u904A\u6232\u6230\u9B25\u6559\u5B78)0-1-4\u5E03\u840A\u514B\uFF08\u958B\u5FC3\u5927\u7B1115\uFF09\uFF1A\u300C\u54C8\u54C8\u54C8\uFF01\u8F15\u8F15\u9B06\u9B06\u5440\uFF5E\u300D\u5C0F\u5630\uFF08\u958B\u5FC33\uFF09\uFF1A\u300C\u5630\u4F30\uFF01\u300D\u5C0F\u547C\uFF08\u5FEB\u6A025\uFF09\uFF1A\u300C\u54AA\u547C\uFF01\u300D\u5C0F\u55B3\uFF08\u865B\u812B1\uFF09\uFF1A\u300C\u55B3\u2026\u2026\u300D\u5E03\u840A\u514B\uFF08\u7B1117\uFF09\uFF1A\u300C\u8F9B\u82E6\u4F60\u5011\u4E09\u500B\u4E86\uFF01\u300D\u5E03\u840A\u514B\uFF08\u632F\u596E13\uFF09\uFF1A\u300C\u4F11\u606F\u4E00\u4E0B\uFF0C\u6E96\u5099\u518D\u51FA\u767C\u5427\uFF01\u300D(\u904A\u6232\u81EA\u7531\u64CD\u4F5C)\u5E8F\u7AE00-2\u8056\u8077\u7526\u9192\u3010\u4E3B\u8981\u4EFB\u52D9\uFF1A\u559A\u9192\u516C\u4E3B\u3011\u4ED6\u722C\u4E0A\u53F0\u968E\uFF0C\u8D70\u5411\u4E86\u9B54\u6CD5\u9663\u524D\u7684\u77F3\u7891\uFF0C\u796D\u58C7\u7684\u4E2D\u5FC3\u6709\u500B\u9B54\u6CD5\u9663\u8207\u77F3\u7891\uFF0C\u5C07\u624B\u4E2D\u7684\u8056\u5178\u5D4C\u5165\u4E86\u77F3\u7891\u4E2D\u592E\uFF0C\u4E00\u9663\u5F37\u5149\u5F8C\uFF0C\u9B54\u6CD5\u66F8\u50CF\u82B1\u6735\u822C\u7DBB\u653E\u958B\u4F86\uFF0C\u9801\u9762\u56DB\u6563\uFF0C\u96A8\u8457\u8056\u5178\u7684\u5149\u8292\u6697\u4E0B\uFF0C\u9B54\u6CD5\u9663\u4E2D\u592E\u4E00\u540D\u6C89\u7761\u7684\u5C11\u5973\u5F9E\u4E2D\u7526\u9192\u3002\u5728\u8207\u5C11\u5973\u7C21\u55AE\u4EA4\u6D41\u5F8C\uFF0C\u5C11\u5973\u53EA\u8A18\u8D77\u81EA\u5DF1\u7684\u540D\u5B57\u53EB\u840A\u83C8\uFF0C\u5931\u53BB\u4E86\u5176\u4ED6\u7684\u8A18\u61B6\uFF0C\u6240\u4EE5\u4E5F\u4E26\u4E0D\u6E05\u695A\u81EA\u5DF1\u70BA\u4F55\u5728\u6B64\u30020-2-1(Timeline\u52D5\u756B3\u62C9\u9060\u5F80\u53F3\u62C9\u8B93\u73A9\u5BB6\u80FD\u4E00\u7ABA\u795E\u79D8\u7684\u907A\u5740)\u5E03\u840A\u514B\uFF08\u597D\u594717\uFF09\uFF1A\u300C\u597D\u795E\u5947\u7684\u5730\u65B9\u554A\u2026\u2026\u300D\u5C0F\u5630\uFF08\u9707\u9A5A4\uFF09\uFF1A\u300C\u5630\u4F30\uFF01\u300D\u5C0F\u547C\uFF08\u7DCA\u5F354\uFF09\uFF1A\u300C\u54AA\u547C\u2026\u2026\u54AA\u547C\uFF01\u300D\u5E03\u840A\u514B\uFF08\u76BA\u77095\uFF09\uFF1A\u300C\u5478\u5478\u5478\uFF01\u5225\u4E82\u8B1B\uFF0C\u4EC0\u9EBC\u50CF\u5893\u7891\u2026\u2026\u592A\u6666\u6C23\u4E86\u5427\uFF01\u300D\u5E03\u840A\u514B\uFF08\u5FD0\u5FD1\u4E0D\u5B892\uFF09\uFF1A\u300C\uFF08\u5495\u5695\uFF09\u2026\u2026\u300D0-2-2(\u77F3\u7891\u4E92\u52D5)\u5E03\u840A\u514B\uFF08\u601D\u800310\uFF09\uFF1A\u300C\u9019\u500B\u5716\u6848\u2026\u2026\u611F\u89BA\u5728\u54EA\u88E1\u898B\u904E\u3002\u300D(\u6F2B\u756BCG\u5448\u73FE01)\u5E03\u840A\u514B\uFF08\u5927\u53EB5\uFF09\uFF1A\u300C\u554A\uFF0C\u7CDF\u4E86\uFF01\u9B54\u6CD5\u66F8\uFF01\u300D\u5C0F\u5630\uFF08\u9707\u9A5A4\uFF09\uFF1A\u300C\u5630\u4F30\uFF01\u300D\u5E03\u840A\u514B\uFF08\u624B\u5FD9\u8173\u4E827\uFF09\uFF1A\u300C\u600E.
