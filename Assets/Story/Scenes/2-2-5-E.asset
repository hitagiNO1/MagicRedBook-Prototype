      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6211\u5011\u4E00\u76F4\u2026\u2026\u4E00\u76F4\u90FD\u662F\u4E92\u76F8\u966A\u4F34\u8457\u5C0D\u65B9\u9577\u5927\u3002"
