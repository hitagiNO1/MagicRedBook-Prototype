      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4F46\u2026\u2026\u537B\u89BA\u5F97\u597D\u771F\u5BE6\uFF0C\u5F77\u5F7F\u771F\u7684\u767C\u751F\u904E\u4E00\u6A23\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
