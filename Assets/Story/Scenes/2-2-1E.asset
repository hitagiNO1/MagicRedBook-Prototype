      spriteIndex: 0
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "(\u4E00\u9663\u98A8\u5439\u904E\uFF0C\u8072\u97F3\u8207\u6C23\u606F\u4E00\u4F75\u6D88\u5931\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u53EF\u60E1\uFF01\u88AB\u4ED6\u800D\u5F97\u5718\u5718\u8F49\uFF01"
