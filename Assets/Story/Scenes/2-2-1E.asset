    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 11
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u525B\u525B\u7684\u756B\u9762\u88E1\u2026\u2026\u597D\u50CF\u9084\u6709\u8AAA\u5230\u5E03\u840A\u514B\u2026\u2026"
