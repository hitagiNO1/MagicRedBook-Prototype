      spriteIndex: 1
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6C92\u60F3\u5230\u59B3\u5C45\u7136\u8DDF\u8457\u9032\u4F86\u4E86\u3002"
    speaker: {fileID: 11400000, guid: 890fa1b73467162448a945d4d33ef9a5, type: 2}
