    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 1
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6C92\u60F3\u5230\u59B3\u5C45\u7136\u8DDF\u8457\u9032\u4F86\u4E86\u3002"
    speaker: {fileID: 11400000, guid: 890fa1b73467162448a945d4d33ef9a5, type: 2}
    actions: []
    timline: []
  - text: "\uFF01\uFF01\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 8
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u4F86\u81EA\u5F37\u5927\u6575\u4EBA\u7684\u5A01\u58D3\uFF0C\u8B93\u840A\u83C8\u4E0B\u610F\u8B58\u7684\u77AC\u9593\u7E43\u7DCA\u795E\u7D93\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u8AB0\u5728\u90A3\u88E1\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 8
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u624D\u525B\u4EA4\u624B\u904E\u5462\uFF0C\u9019\u9EBC\u5FEB\u5C31\u5FD8\u8A18\u4E86\u55CE\uFF1F"
    speaker: {fileID: 11400000, guid: 890fa1b73467162448a945d4d33ef9a5, type: 2}
    actions: []
    timline: []
  - text: "\u662F\u4F60......\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u795E\u79D8\u4EBA\u7269\u767C\u51FA\u4E00\u8072\u8F15\u7B11\uFF0C\u8072\u97F3\u50CF\u662F\u5728\u610F\u8B58\u6DF1\u8655\u97FF\u8D77\uFF0C\u4EE4\u5979\u7121\u6CD5\u9396\u5B9A\u5176\u65B9\u4F4D\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: ......
    speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u5FF5\u7269\u554A......\u6709\u770B\u5230\u4EC0\u9EBC\u719F\u6089\u7684\u6771\u897F\u55CE\uFF1F"
    speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
      spriteIndex: 1
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u9019\u4E9B\u5E7B\u89BA\u662F\u4F60\u641E\u7684\u9B3C\u55CE\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u300E\u5FF5\u7269\u300F\u6307\u7684\u662F\u2014\u2014\u751F\u524D\u5FF5\u5FF5\u4E0D\u5FD8\u4E4B\u7269\u3002\u7121\u8AD6\u559C\u6012\u54C0\u6A02\uFF0C\u90A3\u4E9B\u7247\u523B\uFF0C\u6B7B\u5F8C\u4ECD\u6DF1\u690D\u5728\u8A18\u61B6\u6DF1\u8655\uFF0C\u6C38\u4E0D\u6563\u53BB\u3002"
    speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u5225\u8DDF\u6211\u626F\u4E9B\u5EE2\u8A71\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 21
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5FEB\u628A\u5E03\u840A\u514B\u653E\u958B\uFF0C\u7701\u8457\u6211\u53BB\u63CD\u4F60\u4E00\u9813\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 22
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u96D6\u7136\u5634\u4E0A\u6C23\u52E2\u6D36\u6D36\uFF0C\u5167\u5FC3\u537B\u65E9\u5DF2\u52D5\u6416\u3002\u5979\u5F37\u8FEB\u81EA\u5DF1\u51B7\u975C\uFF0C\u85C9\u8457\u5C0D\u8A71\u62D6\u5EF6\u6642\u9593\uFF0C\u627E\u51FA\u5C0D\u65B9\u7684\u4F4D\u7F6E\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u5225\u767D\u8CBB\u529B\u6C23\u4E86\uFF0C\u7D42\u9EDE\u2026\u2026\u9084\u9060\u7684\u5F88\u5462\u3002"
    speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
      spriteIndex: 5
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u4F60\u5728\u8AAA\u4E9B\u4EC0\u9EBC\uFF1F\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
