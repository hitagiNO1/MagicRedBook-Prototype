      spriteIndex: 9
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u7576\u59B3\u60F3\u8D77\u4E00\u5207\u771F\u76F8\u6642\u2026\u2026\u6211\u5011\u5C31\u6703\u518D\u898B\u9762\u7684\u3002"
