      spriteIndex: 11
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4E0D\u884C\uFF01\u4EC0\u9EBC\u90FD\u60F3\u4E0D\u8D77\u4F86\u2026\u2026\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
