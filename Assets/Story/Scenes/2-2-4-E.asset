      spriteIndex: 25
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4E8B\u5230\u5982\u4ECA\uFF0C\u8490\u96C6\u9019\u4E9B\u9084\u6709\u4EC0\u9EBC\u610F\u7FA9......"
