    - speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
      spriteIndex: 1
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "(\u5C0D\u65BC\u795E\u79D8\u4EBA\u7269\u7684\u518D\u5EA6\u73FE\u8EAB\uFF0C\u7121\u529B\u627F\u53D7\u7684\u840A\u83C8\uFF0C\u5DF2\u7D93\u6C92\u529B\u6C23\u53BB\u53CD\u64CA\u4E86\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u9019\u500B\u662F......\u5931\u8E64\u7684\u9801\u9762......\uFF1F"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
