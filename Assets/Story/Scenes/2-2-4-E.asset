    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 19
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u2026\u2026\u6211\u66FE\u7D93\uFF0C\u2026\u2026\u60F3\u7576\u4E00\u540D\u6B4C\u624B\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 20
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u662F\u7684\uFF0C\u59B3\u7684\u5922\u60F3\uFF0C\u662F\u6210\u70BA\u4E00\u540D\u81EA\u5F48\u81EA\u5531\u7684\u6B4C\u624B\u3002"
    speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u9019\u6BB5\u56DE\u61B6\uFF0C\u6B63\u662F\u59B3\u5922\u60F3\u7684\u8D77\u9EDE\u3002"
    speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
