      timing: 0
  - text: "\u5E03\u840A\u514B\u624B\u4E0A\uFF0C\u88AB\u55BB\u70BA\u201D\u9810\u8A00\u4E4B\u66F8\u201D\uFF0C\u5C6C\u65BC\u516C\u4E3B\u7684\u9B54\u6CD5\u7D05\u66F8\u3002"
