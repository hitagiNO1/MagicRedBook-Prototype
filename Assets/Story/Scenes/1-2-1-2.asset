      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u54A6\uFF1F\u7ADF\u7136\u5B8C\u5168\u4E0D\u75DB\u4E86......"
    speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
