      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u9019\u662F\u4EC0\u9EBC\u9B54\u6CD5\uFF01\u592A\u795E\u5947\u4E86\uFF01\uFF01\u5C45\u7136\u6062\u5FA9\u7684\u5B8C\u597D\u5982\u521D\uFF01\uFF01"
    speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
      spriteIndex: 6
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u770B\u6211\u7684\u5C0F\u96E8\u5098\uFF5E\u539F\u672C\u7834\u7834\u721B\u721B\u7684\uFF0C\u5982\u4ECA\u7165\u7136\u4E00\u65B0\uFF01"
    speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
      spriteIndex: 3
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u9084\u6709\u9084\u6709\u65C1\u908A\u9019\u4F4D\u51B7\u9177\u7684\u8C93\u5148\u751F\uFF0C\u525B\u525B\u7684\u6230\u9B25\u9084\u771F\u662F\u5E25\u6C23\u5440\uFF01\u90A3\u500B\u52D5\u4F5C\u83EF\u9E97\u53C8\u6D41\u66A2\uFF0C\u7C21\u76F4\u592A\u512A\u96C5\u4E86\uFF01"
    speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
