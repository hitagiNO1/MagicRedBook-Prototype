  sentences:
  - text: "\u554A\u554A\u554A\u554A\u554A\u2014\u2014\u5514\u54C7\u5440\uFF01"
    speaker: {fileID: 11400000, guid: 2f4f881bd9fcf0f428232bfffe413220, type: 2}
    actions: []
    timline: []
  - text: "\u55DA\u54C7\u2026\u2026\u5C41\u80A1\u597D\u75DB\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 5
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u9019\u88E1\u662F\u54EA\u88E1......\uFF1F"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u964C\u751F\u7684\u5730\u65B9......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 9
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4E5F\u6C92\u770B\u898B\u5E03\u840A\u514B\u8E64\u8DE1......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 9
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u840A\u83C8\u74B0\u9867\u56DB\u5468\uFF0C\u5230\u8655\u90FD\u662F\u5947\u5F62\u602A\u72C0\u7684\u7269\u4EF6\u3002\u50CF\u662F\u88AB\u4E1F\u68C4\u7684\u56DE\u61B6\u788E\u7247\u3001\u904E\u6642\u7684\u65E5\u7528\u54C1\uFF0C\u6DF7\u4E82\u5730\u6563\u843D\u5728\u9019\u7A7A\u9593\uFF0C\u5F77\u5F7F\u9019\u88E1\u662F\u4E00\u5EA7\u610F\u8B58\u7684\u5783\u573E\u5834\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u9019\u88E1\u4E5F\u592A\u8A6D\u7570\u4E86\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 8
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u8A72\u4E0D\u6703\u2026\u2026\u6211\u6389\u9032\u90A3\u50A2\u4F19\u8A2D\u7684\u9677\u9631\u4E86\u5427\uFF1F"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 11
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u7B97\u4E86\uFF0C\u5148\u51B7\u975C\u4E0B\u4F86\u2026\u2026\u56DB\u8655\u770B\u770B\uFF0C\u6709\u6C92\u6709\u4EC0\u9EBC\u7DDA\u7D22\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 5
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
