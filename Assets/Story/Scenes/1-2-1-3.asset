    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 5
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4ED6\u5011\u805A\u96C6\u5728\u4E00\u8D77\u4E00\u5B9A\u662F\u6709\u539F\u56E0\u7684\uFF0C\u50CF\u662F\u88AB\u67D0\u7A2E\u529B\u91CF\u5438\u5F15\u4E00\u6A23\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
