  - text: "\u8F9B\u82E6\u4E86\uFF01\u5169\u4F4D\u71B1\u5FC3\u8178\u7684\u5927\u4FE0\u5011\uFF0C\u5982\u679C\u4ECA\u5929\u6C92\u6709\u9047\u898B\u4F60\u5011\u3002"
