  - text: "\u81A0\u5E36\u53F0\u5148\u751F\uFF0C\u9019\u500B\u66F8\u9801\u53EF\u4EE5\u7D66\u6211\u5011\u4FDD\u7BA1\u55CE\uFF1F"
