      spriteIndex: 4
      actionType: 5
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4F60\u8A72\u4E0D\u6703\u4F60\u6709\u64BF\u5230\u4E00\u584A\u50CF\u65E5\u8A18\u4E00\u6A23\u7684\u66F8\u9801\uFF01"
