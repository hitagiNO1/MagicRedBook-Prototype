      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "(\u81A0\u5E36\u53F0\u5148\u751F\u62FF\u51FA\u4E00\u9801\u795E\u7955\u6C23\u606F\u7684\u66F8\u9801\uFF0C\u96B1\u96B1\u6563\u767C\u8457\u529B\u91CF\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u9019\u662F\u4E0D\u4E45\u524D\u6211\u8D70\u5728\u68EE\u6797\u5C0F\u5F91\u64BF\u5230\u7684\uFF0C\u6211\u89BA\u5F97\u633A\u65B0\u5947\uFF0C\u5C31\u9806\u624B\u64BF\u4E86\u8D77\u4F86\u3002"
