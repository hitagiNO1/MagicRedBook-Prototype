      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6211\u548C\u5E03\u840A\u514B......\u66FE\u7D93\u751F\u6D3B\u5728\u4E00\u8D77\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 25
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u800C\u4E14......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 9
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u9019\u4E9B\u4E0D\u662F\u6211\u7684\u8A18\u61B6\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 9
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u662F\u5E03\u840A\u514B\u7684\u8A18\u61B6\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 25
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u770B\u4F86\u59B3\u7D42\u65BC\u9032\u5165\u72C0\u6CC1\u4E86\u3002"
    speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "(\u719F\u6089\u7684\u58D3\u8FEB\u611F\u518D\u5EA6\u7C60\u7F69\uFF0C\u539F\u672C\u71C3\u71D2\u7684\u6012\u706B\uFF0C\u537B\u5728\u672A\u77E5\u8207\u56F0\u60D1\u9762\u524D\uFF0C\u6084\u7136\u88AB\u6050\u61FC\u53D6\u4EE3\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u53C8\u662F\u4F60\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 18
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u70BA\u4EC0\u9EBC\u6211\u770B\u5230\u7684\u9019\u4E9B\uFF0C\u662F\u5E03\u840A\u514B\u7684\u8A18\u61B6\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 18
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5FF5\u7269......\u662F\u751F\u524D\u7684\u8A18\u61B6\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 23
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5982\u679C\u90A3\u4E9B\u8A18\u61B6\u662F\u771F\u7684\uFF0C\u96E3\u9053\u5E03\u840A\u514B\u5DF2\u7D93\u88AB\u4F60......\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 21
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4E00\uFF0C \u59B3\u770B\u5230\u7684\uFF0C\u78BA\u5BE6\u662F\u5E03\u840A\u514B\u7684\u300E\u5FF5\u7269\u300F\u3002"
    speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u4E8C\uFF0C \u5FF5\u7269\u88E1\u7684\u8A18\u61B6\u90FD\u662F\u771F\u771F\u5207\u5207\u767C\u751F\u5728\u73FE\u5BE6\u3002"
    speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
      spriteIndex: 2
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u4E0D\u540C\u65BC\u9019\u500B\u5E7B\u60F3\u4E16\u754C\uFF0C\u800C\u662F\u771F\u5BE6\u7684\u4E16\u754C\u88E1\u3002"
    speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
      spriteIndex: 2
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u771F\u5BE6......\u7684\u4E16\u754C\uFF1F\u9019\u662F\u4EC0\u9EBC\u610F\u601D\uFF01\uFF01\uFF01"
