      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u7E7C\u7E8C\u524D\u9032\u5427\uFF0C\u9084\u6709\u66F4\u591A\u771F\u76F8\u7B49\u8457\u4F60\u53BB\u63A2\u5C0B\u3002"
