      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u9019\u5C31\u662F\u4ED6\u7684\u672B\u8DEF\uFF0C\u60F3\u8D77\u4F86\u4E86\u55CE\uFF1F"
    speaker: {fileID: 11400000, guid: 782db9cfa2b21e64e83db65b0f0a00ae, type: 2}
