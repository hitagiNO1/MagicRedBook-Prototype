      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u5176\u5BE6\u6211\u4E5F\u4E0D\u592A\u6E05\u695A\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 13
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u53EA\u731C\u5230\u516C\u4E3B\u6703\u5728\u8349\u6069\u7684\u68EE\u6797\u88E1\uFF0C\u4F46\u6211\u4E0D\u6E05\u695A\u78BA\u5207\u7684\u4F4D\u7F6E\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 13
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u81EA\u5F9E\u8E0F\u4E0A\u65C5\u7A0B\u5F8C\uFF0C\u9019\u4E00\u5E74\u90FD\u6C92\u4EC0\u9EBC\u9032\u5C55\u3002\u76F4\u5230\u4F86\u5230\u8349\u6069\uFF0C\u624D\u904E\u5E7E\u5929\u5C31\u627E\u5230\u516C\u4E3B\u59B3\u4E86\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 15
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u53EF\u80FD\u9B54\u6CD5\u7D05\u66F8\u9ED8\u9ED8\u7684\u6307\u5F15\u6211\u4E5F\u8AAA\u4E0D\u5B9A\uFF1F"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u8AAA\u5230\u9019\u500B\uFF0C\u4F60\u6709\u770B\u904E\u88E1\u9762\u7684\u5167\u5BB9\u55CE\uFF1F"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6C92\u6709\u8036\uFF0C\u4E4B\u524D\u5617\u8A66\u904E\u5F88\u591A\u6B21\uFF0C\u4E0D\u904E\u4E0D\u7BA1\u4F7F\u51FA\u591A\u5927\u7684\u52C1\uFF0C\u537B\u9023\u4E00\u500B\u7E2B\u9699\u90FD\u6253\u4E0D\u958B\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 11
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u96E3\u9053\u8AAA......\u6703\u6709\u4EC0\u9EBC\u8A5B\u5492\u55CE\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u54C8\u54C8\u54C8\u7576\u7136\u6C92\u6709\uFF0C\u54EA\u6709\u9019\u9EBC\u56B4\u91CD\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 6
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u9B54\u6CD5\u7D05\u66F8\u9700\u8981\u6211\u7684\u529B\u91CF\u624D\u80FD\u958B\u555F\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u53EA\u6709\u6211\u8A8D\u53EF\u904E\u7684\u4EBA\u624D\u80FD\u7FFB\u958B\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 14
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u662F\u6211\u7CBE\u5FC3\u6E96\u5099\u7684\u9632\u76DC\u63AA\u65BD\uFF5E\u5F88\u8070\u660E\u5427\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 2
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u840A\u83C8\u727D\u8D77\u5E03\u840A\u514B\u7684\u624B\uFF0C\u5634\u4E2D\u9ED8\u5FF5\u8457\u5E7E\u53E5\u5492\u8A9E\uFF0C\u5468\u570D\u5FAE\u5FAE\u6CDB\u8D77\u4E00\u9663\u767D\u5149\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u597D\u5566\uFF0C\u6211\u628A\u9B54\u529B\u5206\u7D66\u4F60\uFF0C\u9019\u6A23\u4F60\u4E5F\u80FD\u4F7F\u7528\u4E86\uFF01"
