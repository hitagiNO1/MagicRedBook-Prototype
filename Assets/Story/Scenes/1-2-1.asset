      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6211\u60F3\u554F\u4F60\uFF0C\u7576\u521D\u662F\u600E\u9EBC\u627E\u5230\u6211\u7684\u5440\uFF1F"
