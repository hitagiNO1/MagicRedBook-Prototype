      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4EC0\u9EBC\u561B\uFF0C\u5C31\u9019\u9EDE\u5C0F\u4E8B\u600E\u9EBC\u53EB\u9019\u9EBC\u5927\u8072......"
