  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: S1-3-3
  m_EditorClassIdentifier: 
  StopMove: 0
  sentences:
  - text: "\u96D6\u7136\u9084\u5728\u68EE\u6797\u88E1\uFF0C\u4F46\u4E5F\u592A\u6697\u4E86\u5427\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 27
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u73FE\u5728\u61C9\u8A72\u9084\u662F\u767D\u5929\u554A\uFF1F\u70BA\u4EC0\u9EBC\u5B8C\u5168\u6C92\u6709\u967D\u5149......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 25
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u68EE\u6797\u6DF1\u8655\u7684\u5149\u7DDA\u8A6D\u7570\u5F97\u51FA\u5947\uFF0C\u5468\u570D\u7684\u6A39\u6728\u7570\u5E38\u9AD8\u5927\uFF0C\u85E4\u8513\u626D\u66F2\u5730\u5782\u639B\u4E0B\u4F86\uFF0C\u539A\u91CD\u7684\u6A39\u51A0\u5C01\u4F4F\u4E86\u967D\u5149\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u7A7A\u6C23\u4E5F\u5F88\u60B6\u2026\u2026\u6574\u500B\u5730\u65B9\u6B7B\u6C23\u6C89\u6C89\u7684\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 2
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u840A\u83C8\u2026\u2026\u59B3\u6709\u6C92\u6709\u89BA\u5F97\uFF0C\u6709\u6771\u897F\u5728\u76EF\u8457\u6211\u5011\uFF1F"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 7
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 8
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u800C\u4E14\u4E0D\u53EA\u4E00\u9053\u8996\u7DDA\uFF0C\u662F\u5F88\u591A\u9053\uFF0C\u50CF\u6574\u7247\u6797\u5B50\u90FD\u5728\u770B\u6211\u5011\u4E00\u6A23\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 7
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u4F60\u662F\u8AAA\u2026\u2026\u9019\u4E9B\u690D\u7269\uFF1F"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 9
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5B83\u5011\u9577\u5F97\u4E0D\u6B63\u5E38\uFF0C\u5168\u90FD\u5927\u5F97\u8A87\u5F35\uFF0C\u50CF\u662F\u88AB\u2026\u2026\u4EC0\u9EBC\u6771\u897F\u9935\u990A\u904E\uFF0C\u5F37\u884C\u6490\u5927\u4E86\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 2
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u5E03\u840A\u514B\uFF01\u9B54\u6CD5\u66F8\u2026\u2026\u5B83\u5728\u767C\u5149\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 13
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u7D05\u66F8\u5F9E\u6D6E\u8D77\u5FAE\u5F31\u7684\u767D\u5149\uFF0C\u5230\u5FEB\u901F\u9583\u720D\uFF0C\u4EE3\u8868\u8457\u4EC0\u9EBC\u6771\u897F\u5FEB\u901F\u9760\u8FD1\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline:
    - animation: 1
      myPlayableAsset: {fileID: 11400000, guid: 02861c9db17848d4b8c70abfa5d2fc55, type: 2}
      timing: 0
  - text: "\u5C0F\u5FC3\uFF01\u5730\u9762\u5728\u9707\u52D5\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  nextScene: {fileID: 0}
