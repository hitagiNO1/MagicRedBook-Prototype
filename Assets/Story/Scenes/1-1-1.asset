      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u9B54\u6CD5\u7D05\u66F8\u98C4\u6D6E\u5728\u7A7A\u4E2D\uFF0C\u6563\u767C\u8457\u5149\u8292\u986F\u5F97\u683C\u5916\u795E\u79D8)\u3002"
