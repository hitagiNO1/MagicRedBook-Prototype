      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5630\u4F30\u2026\u2026\uFF1F"
    speaker: {fileID: 11400000, guid: eec5a822a2838904aa349f646a9c0c4d, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 709183c23759f8c4b92ce15d294564e9, type: 2}
      spriteIndex: 1
      actionType: 4
      coords: {x: 0, y: 0}
