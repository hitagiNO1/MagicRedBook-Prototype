    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 11
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6240\u4EE5\u6211\u624D\u76F8\u4FE1\u2026\u2026\u53EA\u8981\u627E\u5230\u9019\u500B\u5730\u65B9\uFF0C\u5C31\u80FD\u627E\u5230\u6551\u8D16\u8C93\u4E4B\u570B\u7684\u65B9\u6CD5\uFF01"
