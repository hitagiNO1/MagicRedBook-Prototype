      spriteIndex: 16
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u54FC\u54FC\uFF5E\u6191\u6211IQ180\u7684\u63A8\u7406\uFF0C\u9019\u88E1\u2014\u2014\u8349\u6069\uFF0C\u5C31\u662F\u9810\u8A00\u4E2D\u63D0\u5230\u7684\u5730\u65B9\uFF01"
