  sentences:
  - text: "\u8AAA\u8D77\u4F86\u2026\u2026\u96E2\u958B\u5BB6\u9109\u4E5F\u5FEB\u4E00\u5E74\u4E86\uFF0C\u53EF\u9084\u662F\u4E00\u9EDE\u9032\u5C55\u4E5F\u6C92\u6709\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 11
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u8349\u6069\u2026\u2026\u9019\u500B\u5730\u65B9\uFF0C\u771F\u7684\u80FD\u627E\u5230\u516C\u4E3B\u55CE\uFF1F"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 11
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u7B97\u4E86\uFF0C\u60F3\u90A3\u9EBC\u591A\u4E5F\u6C92\u7528\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 10
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u73FE\u5728\u552F\u4E00\u80FD\u505A\u7684\u5C31\u662F\u627E\u5230\u516C\u4E3B\uFF0C\u8ACB\u5979\u8DDF\u6211\u5011\u8D70\u4E00\u8D9F\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 2
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\uFF08\u5E03\u840A\u514B\u4F4E\u982D\u770B\u5411\u624B\u4E2D\u7684\u7D05\u66F8\u5E03\u840A\u514B\u4F4E\u982D\u770B\u5411\u624B\u4E2D\u7684\u9B54\u6CD5\u66F8\uFF0C\u96B1\u96B1\u6563\u767C\u8457\u5FAE\u5F31\u7684\u529B\u91CF\uFF09"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 13
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u9019\u4E00\u5B9A\u662F\u4E00\u672C\u771F\u6B63\u7684\u9B54\u6CD5\u66F8\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
