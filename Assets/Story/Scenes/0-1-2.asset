    - speaker: {fileID: 11400000, guid: eec5a822a2838904aa349f646a9c0c4d, type: 2}
      spriteIndex: 0
      actionType: 5
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u54A6\uFF1F\u4F60\u554F\u6211\uFF0C\u516C\u4E3B\u7684\u50B3\u8AAA\u662F\u4EC0\u9EBC\uFF1F"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u54C8\u54C8\u54C8\u54C8\u54C8\uFF5E\u4F60\u5011\u5C45\u7136\u4E0D\u77E5\u9053\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5F9E\u524D\u554A\uFF0C\u6709\u4F4D\u516C\u4E3B\u4F86\u5230\u4E86\u8C93\u4E4B\u570B\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u807D\u8AAA\u5979\u8E0F\u904E\u7684\u571F\u5730\uFF0C\u9023\u77F3\u982D\u90FD\u6703\u9577\u51FA\u7A3B\u7A57\u4F86\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 16
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u516C\u4E3B\u7684\u6B4C\u8072\u4F7F\u7A3B\u7A57\u98FD\u6EFF\uFF0C\u9B54\u6CD5\u91AB\u767E\u75C5\uFF0C\u5176\u795E\u8E5F\u4E0D\u52DD\u679A\u8209\uFF0C\u7121\u4E0D\u4EE4\u4EBA\u7A31\u5947\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 15
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u7136\u800C\u5929\u5730\u7121\u5E38\uFF0C\u67D0\u5929\u516C\u4E3B\u5FFD\u7136\u6D88\u8DE1\u7121\u8E64\uFF0C\u53EA\u7559\u4E0B\u4E00\u672C\u9B54\u6CD5\u7D05\u66F8\u8207\u4E00\u53E5\u50B3\u805E"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 11
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u2014\u2014\u300C\u5145\u6EFF\u6069\u60E0\u4E4B\u5730\uFF0C\u8056\u8005\u9577\u7720\u4E4B\u8655\u300D\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
