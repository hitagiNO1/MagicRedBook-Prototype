    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 16
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u53EF\u662F\u6751\u88E1\u7684\u4EBA\u90FD\u4E0D\u80AF\u76F8\u4FE1\u6211\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 11
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5927\u5BB6\u53EA\u628A\u5B83\u7576\u6210\u4E00\u672C\u7834\u820A\u7684\u66F8\uFF0C\u5C31\u9023\u516C\u4E3B\u7684\u50B3\u8AAA\u4E5F\u88AB\u7576\u6210\u7B11\u8A71\u770B\u5F85......"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 8
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u54AA\u547C\uFF5E"
