      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u68EE\u6797\u6DF1\u8655\uFF1F\u90A3\u88E1\u6709\u4EC0\u9EBC\u55CE\uFF1F"
