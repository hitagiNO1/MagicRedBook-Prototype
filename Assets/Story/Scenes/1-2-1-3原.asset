  sentences:
  - text: "\u771F\u662F\u500B\u5929\u624D\u5440\uFF01\u606D\u559C\u4F60\u901A\u904E\u81A0\u5E36\u62F3\u8A66\u7149\uFF01\u9019\u662F\u9001\u4F60\u7684\u79AE\u7269\uFF01"
    speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
      spriteIndex: 4
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u5E03\u840A\u514B\u4F60\u597D\u68D2\uFF01\u771F\u7684\u6490\u4F4F\u4E86\u8036\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 16
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5443\u55DA\u55DA\u55DA\u3000\u9084\u6C92\u7DE9\u904E\u4F86......"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 16
