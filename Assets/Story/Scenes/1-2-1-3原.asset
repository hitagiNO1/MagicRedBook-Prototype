      coords: {x: 0, y: 0}
      Right: 0
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 17
      actionType: 5
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u597D\u5566\uFF0C\u8F9B\u82E6\u4E86\uFF0C\u4F86\uFF0C\u6211\u5E6B\u4F60\u6495\u6389\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 14
      actionType: 4
      coords: {x: 0, y: 0}
      Right: 0
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 0
      actionType: 5
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u7D42\u65BC\u81EA\u7531\u4E86\u2026\u2026"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 0
      actionType: 4
      coords: {x: 0, y: 0}
      Right: 0
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 17
      actionType: 5
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u597D\u4E86\uFF0C\u90A3\u9EBC\u5C0F\u7684\u6211\u5DEE\u4E0D\u591A\u8981\u544A\u8FAD\u4E86\uFF01"
    speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
      spriteIndex: 1
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u4F60\u63A5\u4E0B\u4F86\u8981\u53BB\u54EA\u88E1\u5462\uFF1F"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 14
      actionType: 4
      coords: {x: 0, y: 0}
      Right: 0
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 7
      actionType: 5
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u56DE\u6211\u7684\u8001\u5BB6\u53BB\uFF0C\u6C92\u60F3\u5230\u9019\u8D9F\u65C5\u7A0B\u9084\u80FD\u898B\u5230\u9019\u9EBC\u5B8C\u7F8E\u7684\u62F3\u6CD5\uFF0C\u5DF2\u7D93\u5FC3\u6EFF\u610F\u8DB3\u4E86\u3002"
    speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
      spriteIndex: 6
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u5C0F\u5FC3\u5225\u53C8\u88AB\u602A\u7269\u7E8F\u4E0A\u4E86\u5594\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 7
      actionType: 4
      coords: {x: 0, y: 0}
      Right: 0
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 16
      actionType: 5
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u653E\u5FC3\u653E\u5FC3\uFF0C\u6211\u6703\u907F\u958B\u4ED6\u5011\u7684\uFF5E\u4F60\u5011\u4E5F\u5225\u5F80\u68EE\u6797\u6DF1\u8655\u53BB\uFF0C\u90A3\u88E1\u5F88\u5371\u96AA\uFF01"
    speaker: {fileID: 11400000, guid: c3ccda3cb82c2fe4f8d86cf55714aeca, type: 2}
