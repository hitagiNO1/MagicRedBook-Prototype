      spriteIndex: 5
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u597D\u7684\uFF01\u6211\u5011\u6703\u6CE8\u610F\u5B89\u5168\uFF01"
