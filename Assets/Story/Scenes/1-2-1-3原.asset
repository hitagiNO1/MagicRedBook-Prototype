      spriteIndex: 4
      actionType: 5
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u807D\u8AAA\u90A3\u88E1\u904A\u8569\u7684\u602A\u7269\u66F4\u591A\u3001\u66F4\u52A0\u96E3\u7E8F......"
