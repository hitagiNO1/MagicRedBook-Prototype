  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: 2-2-3
  m_EditorClassIdentifier: 
  StopMove: 0
  sentences:
  - text: "\u563B\u563B\u563B\uFF5E\u54C8\u54C8\u54C8\u54C8\u54C8\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u5E03\u840A\u514B\u4F60\u770B\uFF01\u9019\u6A23\u50CF\u4E0D\u50CF\u6211\u7684\u5076\u50CF\uFF5E\uFF1F"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "......\u55B5\u3002"
    speaker: {fileID: 11400000, guid: 99a7a061a13d5544998fdf3ccbd5365e, type: 2}
    actions: []
    timline: []
  - text: "\u54C8\u54C8\u54C8\u54C8\u54C8\uFF5E"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u554A......\u6211\u7684\u5076\u50CF......\u5979\u771F\u7684\u8D85\u53B2\u5BB3\u7684\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5979\u7684\u8072\u97F3\uFF0C\u6EAB\u67D4\u53C8\u5E36\u8457\u60C5\u611F......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u6BCF\u6B21\u807D\u5979\u5531\u6B4C\uFF0C\u90FD\u6703\u88AB\u5979\u7684\u8072\u97F3\u5438\u5F15\u4F4F\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "......\u55B5\u55DA\u3002"
    speaker: {fileID: 0}
    actions: []
    timline: []
  - text: "\u800C\u4E14\u4E0D\u53EA\u662F\u6B4C\u8072\uFF0C\u5979\u7684\u5916\u8868\u4E5F\u597D\u751C\u7F8E\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u771F\u7684\u597D\u6F02\u4EAE\u54E6......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 0}
      spriteIndex: 0
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5979\u9084\u5F88\u6709\u624D\u83EF\uFF0C\u9664\u4E86\u5531\u6B4C\u4E4B\u5916\uFF0C\u9084\u6703\u5F48\u5409\u4ED6\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u7E3D\u6709\u4E00\u5929\uFF0C\u6211\u4E5F\u8981\u8B8A\u6210\u50CF\u5979\u4E00\u6A23\u7684\u4EBA\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 5
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "......\u55B5\uFF01"
    speaker: {fileID: 0}
    actions: []
    timline: []
  - text: "\u54E6\u54E6\u54E6\uFF01\u5C0D\u4E86\uFF0C\u5979\u9084\u53C3\u52A0\u904E\u9078\u79C0\u7BC0\u76EE\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6C7A\u8CFD\u7684\u6642\u5019\uFF0C\u5979\u81EA\u5F48\u81EA\u5531\uFF0C\u7D50\u679C\u2026\u2026\u4E00\u9CF4\u9A5A\u4EBA\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u6211\u5C31\u662F\u90A3\u6642\u5019\u7B2C\u4E00\u6B21\u898B\u5230\u5979\u7684\u2026\u2026\uFF0C\u9084\u88AB\u5979\u7684\u6B4C\u8072\u611F\u52D5\u5230\u54ED\u4E86\u5462\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u554A\u2026\u2026\u771F\u7684\u597D\u559C\u6B61\u5979\u54E6\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 6
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4E0D\u884C\uFF01\u6211\u5FCD\u4E0D\u4F4F\u4E86\uFF0C\u6211\u8981\u518D\u56DE\u53BB\u807D\u4E00\u904D\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  nextScene: {fileID: 0}
