  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: S1-2-3-6
  m_EditorClassIdentifier: 
  StopMove: 0
  sentences:
  - text: "\u6700\u5F8C\u9019\u5F35\u597D\u50CF\u5728\u6230\u9B25\u4E2D\u88AB\u6253\u98DB\uFF0C\u88C2\u958B\u4E86\u2026\u2026"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 10
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u55DA\u55DA\u55DA\u2026\u2026\u90A3\u662F\u6211\u6700\u91CD\u8981\u7684\u4E00\u5F35CD\u2026\u2026"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 2
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u5B83\u80FD\u5531\u51FA\u6700\u597D\u807D\u7684\u8072\u97F3\u2026\u2026\u90A3\u662F\u5979\u6700\u559C\u6B61\u7684CD\u554A\u2026\u2026"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 5
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u6C92\u4E8B\u7684\u2026\u2026\u9019\u6A23\u7684\u88C2\u75D5\u6211\u8AAA\u4E0D\u5B9A\u53EF\u4EE5\u4FEE\u597D\u2026\u2026\u7B49\u6211\u4E00\u4E0B\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 10
      actionType: 4
      coords: {x: 0, y: 0}
      Right: 0
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 7
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4FEE......\u4FEE\u597D\u4E86\uFF01\u8DDF\u65B0\u7684\u4E00\u6A23\uFF01"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 3
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u563F\u563F\uFF5E\u8DDF\u6062\u5FA9\u9B54\u6CD5\u4E00\u6A21\u4E00\u6A23\uFF0C\u53EA\u662F\u628A\u5B83\u61C9\u7528\u5728\u7269\u54C1\u4E0A\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 7
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u54A6\uFF1F\uFF01\u6062\u5FA9\u9B54\u6CD5\u662F\u53EF\u4EE5\u9019\u6A23\u7528\u7684\u55CE......"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 7
      actionType: 4
      coords: {x: 0, y: 0}
      Right: 0
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 6
      actionType: 5
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6211\u7684CD\u5011\u2026\u2026\u5BF6\u8C9D\u5011\u2026\u2026\u90FD\u56DE\u4F86\u4E86\u2026\u2026\uFF01"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u771F\u7684\u592A\u611F\u8B1D\u4F60\u5011\u4E86\uFF01\u5982\u679C\u6211\u4E00\u500B\u4EBA\u4E0D\u77E5\u9053\u8981\u627E\u591A\u4E45......"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 1
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u70BA\u4E86\u611F\u8B1D\u4F60\u5011\uFF0C\u8ACB\u6536\u4E0B\u9019\u500B\u2014\u2014"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "(\u9B54\u6CD5\u66F8\u9583\u720D\u8457\u67D4\u548C\u7684\u5149\u8292\uFF0C\u50CF\u662F\u5728\u56DE\u61C9\u8457\u5206\u96E2\u7684\u9801\u9762\u4E00\u6A23)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u9019\u662F\u6211\u525B\u624D\u5728\u9644\u8FD1\u64BF\u5230\u7684\uFF0C\u6709\u7A2E\u795E\u79D8\u7684\u529B\u91CF\u5438\u5F15\u8457\u6211\u2026\u2026\u6240\u4EE5\u5C31\u4E00\u76F4\u7559\u8457\u5B83\u3002"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u840A\u83C8\u5FEB\u770B\uFF01\u662F\u9B54\u6CD5\u66F8\u7684\u9801\u9762\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5C45\u7136\u6703\u5728\u9019\u88E1\u627E\u5230\u2026\u2026\u771F\u662F\u610F\u5916\u7684\u6536\u7A6B\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 4
      actionType: 4
      coords: {x: 0, y: 0}
      Right: 0
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 16
      actionType: 5
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u80FD\u5920\u627E\u56DE\u5BF6\u8C9D\u5011\uFF0C\u771F\u7684\u90FD\u662F\u56E0\u70BA\u4F60\u5011\u2026\u2026"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 5
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u6211\u5011\u4E5F\u5F88\u958B\u5FC3\uFF0C\u80FD\u5E6B\u4E0A\u4E00\u9EDE\u5FD9\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4E0B\u6B21\u53EF\u5225\u518D\u5F04\u4E1F\u5566\uFF0C\u54ED\u6210\u90A3\u6A23\u5687\u6B7B\u6211\u4E86\u2026\u2026"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 0
      actionType: 4
      coords: {x: 0, y: 0}
      Right: 0
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 0
      actionType: 5
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u554A\u54C8\u54C8\u2026\u2026\u6211\u6703\u5C0F\u5FC3\u7684\uFF0C\u4FDD\u8B49\u518D\u4E5F\u4E0D\u8B93\u5B83\u5011\u96E2\u958B\u6211\u8996\u7DDA\u4E00\u6B65\uFF01"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u90A3\u9EBC\uFF0C\u5F8C\u6703\u6709\u671F\u4E86\u6211\u7684\u82F1\u96C4\u5011\uFF01"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "(\u96A8\u8EAB\u807D\u8F49\u8EAB\uFF0C\u64AD\u653E\u8D77\u8F15\u67D4\u7684\u65CB\u5F8B\uFF0C\u5728\u97F3\u6A02\u4E2D\u9010\u6F38\u9060\u53BB)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  nextScene: {fileID: 0}
