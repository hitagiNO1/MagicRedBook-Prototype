      spriteIndex: 12
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6211\u8981\u627E\u7684\u4EBA\u4E0D\u662F\u59B3\uFF0C\u5916\u4F86\u8005\u3002"
    speaker: {fileID: 11400000, guid: 890fa1b73467162448a945d4d33ef9a5, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 7
      actionType: 4
      coords: {x: 0, y: 0}
      Right: 1
    - speaker: {fileID: 11400000, guid: 890fa1b73467162448a945d4d33ef9a5, type: 2}
      spriteIndex: 1
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u8ACB\u59B3\u4E56\u4E56\u5F85\u8457\u3002"
    speaker: {fileID: 11400000, guid: 890fa1b73467162448a945d4d33ef9a5, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 890fa1b73467162448a945d4d33ef9a5, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u7B49\u7B49......\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 21
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    - speaker: {fileID: 11400000, guid: 890fa1b73467162448a945d4d33ef9a5, type: 2}
      spriteIndex: 0
      actionType: 2
      coords: {x: 0, y: 0}
      Right: 1
    timline:
    - animation: 1
      myPlayableAsset: {fileID: 11400000, guid: abe8d39bb23d63b40a6e29e4490adcab, type: 2}
      timing: 0
  - text: "(\u4E00\u9053\u523A\u773C\u7684\u5149\u8292\u9583\u904E\uFF0C\u8C93\u6B7B\u795E\u8207\u5E03\u840A\u514B\u4E00\u540C\u6D88\u5931\u5F97\u7121\u5F71\u7121\u8E64\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u5E03\u840A\u514B\uFF01\uFF01\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 21
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4E0D......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u600E\u9EBC\u6703\u9019\u6A23......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 11
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u8C93\u6B7B\u795E\u6D88\u5931\u7684\u5730\u65B9\u6563\u767C\u8457\u9663\u9663\u4E0D\u5C0B\u5E38\u7684\u5149\u8292\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "......\u55EF\uFF1F"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 8
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u90A3\u662F\u4EC0\u9EBC\uFF1F"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u539F\u672C\u8C93\u6B7B\u795E\u6240\u5728\u7684\u4F4D\u7F6E\uFF0C\u907A\u7559\u8457\u4E00\u672C\u719F\u6089\u7684\u7D05\u8272\u9B54\u6CD5\u66F8\uFF0C\u975C\u975C\u5730\u8EBA\u5728\u5730\u4E0A\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "(\u65C1\u908A\u5247\u88C2\u958B\u4E00\u9053\u7570\u6A23\u7684\u901A\u9053\uFF0C\u6DF1\u4E0D\u898B\u5E95\uFF0C\u5F77\u5F7F\u901A\u5F80\u672A\u77E5\u7684\u4E16\u754C\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u9B54\u6CD5\u7D05\u66F8......\uFF0C\u5E03\u840A\u514B\u96E2\u958B\u524D\u4E1F\u51FA\u4F86\u7684\u55CE......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 9
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u840A\u83C8\u4F38\u624B\u62FE\u8D77\u7D05\u66F8\uFF0C\u5730\u4E0A\u7684\u6D1E\u53E3\u5247\u9583\u720D\u51FA\u8207\u9B54\u6CD5\u7D05\u66F8\u540C\u983B\u7387\u7684\u5149\u8292\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u9019\u500B\u662F......\u90A3\u50A2\u4F19\u7559\u4E0B\u7684\u55CE\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 21
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u904E\u591A\u7684\u8CC7\u8A0A\u91CF\u6D41\u9032\u840A\u83C8\u8166\u5167\uFF0C\u4E0D\u904E\u6C92\u6709\u592A\u591A\u7559\u7D66\u4ED6\u601D\u8003\u6642\u9593\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u4E0D\u7BA1\u4E86\uFF0C\u70BA\u4E86\u5E03\u840A\u514B\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 5
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6211\u4E0D\u80FD\u5C31\u9019\u6A23\u653E\u68C4\u4ED6\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
