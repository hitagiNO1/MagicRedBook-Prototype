    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 14
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u55DA\u55DA\u55DA......\u54C7\u554A\u554A\u554A......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u5E03\u840A\u514B......\u5C0D\u4E0D\u8D77\u554A......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u5C0D\u4E0D\u8D77......\u5168\u90E8\u90FD\u662F\u6211\u7684\u932F......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u6C92\u6709\u4E86\u4F60\uFF0C\u6211\u8A72\u600E\u9EBC\u8FA6\u554A......."
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u55DA\u55DA......(\u555C\u6CE3\u8072)......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "......\u55B5\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 17
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u547C\u5695\u2014\u2014\u2014\u547C\u5695\u5495\u5695\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u55EF......\uFF1F"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "(\u840A\u83C8\u62AC\u8D77\u624B\uFF0C\u8F15\u8F15\u64AB\u6478\u5E03\u840A\u514B\u7684\u982D\uFF0C\u537B\u611F\u53D7\u4E0D\u5230\u4EFB\u4F55\u4E00\u9EDE\u6EAB\u6696\uFF0C\u800C\u5E03\u840A\u514B\u7684\u9748\u9AD4\u6B63\u4EE5\u8089\u773C\u53EF\u898B\u7684\u901F\u5EA6\u6162\u6162\u6D88\u901D\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u4E0D......\u4E0D\u8981\uFF0C\u4E0D\u884C\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 14
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5E03\u840A\u514B......\u6C42\u6C42\u4F60\uFF0C\u5225\u96E2\u958B\u6211......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: ......
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 17
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5E03\u840A\u514B\u6700\u559C\u6B61\u840A\u83C8\u5531\u6B4C\u4E86\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u559C\u6B61\u840A\u83C8\u4E00\u908A\u5F48\u5409\u4ED6\uFF0C\u4E00\u908A\u5531\u6B4C\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u6BCF\u6B21\u6211\u90FD\u807D\u5230\u7761\u8457\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u5E03\u840A\u514B\uFF0C\u4F60......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u9084\u6709\u5440\uFF01\u9019\u4EF6\u4E8B\u4E0D\u662F\u840A\u83C8\u7684\u932F\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u662F\u6211\u592A\u8ABF\u76AE\u4E86\uFF0C\u563F\u563F\u563F\uFF5E"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u61C9\u8A72\u8981\u4E56\u4E56\u5B88\u5BB6\u7684\uFF0C\u4E0D\u80FD\u4E82\u8DD1\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u53EA\u4E0D\u904E......\u770B\u5230\u840A\u83C8\uFF0C\u5C31\u5FCD\u4E0D\u4F4F\u8FFD\u4E86\u4E0A\u53BB\u561B\uFF5E"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u4E0D\u662F\u9019\u6A23\u7684......\u5E03\u840A\u514B\uFF0C\u8981\u662F\u6211\u518D\u7D30\u5FC3\u4E00\u9EDE\uFF0C\u5C31\u4E0D\u6703\u767C\u751F\u9019\u7A2E\u61BE\u4E8B\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u53EF\u662F\u6211\u4E00\u9EDE\u4E5F\u4E0D\u602A\u840A\u83C8\u5594\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u53EA\u8981\u80FD\u8DDF\u840A\u83C8\u5F85\u5728\u4E00\u8D77......\u5C31\u662F\u6211\u6700\u5E78\u798F\u7684\u6642\u5019\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u7562\u7ADF\u6211......\u6700\u559C\u6B61\u840A\u83C8\u4E86\uFF01\uFF01\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u5E03\u840A\u514B......\u8B1D\u8B1D\u4F60......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 14
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u8B1D\u8B1D\u4F60\uFF0C\u966A\u4F34\u6211\u9577\u5927\uFF0C\u966A\u4F34\u6211\u5EA6\u904E\u6BCF\u500B\u4EBA\u751F\u968E\u6BB5\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u8B1D\u8B1D\u4F60\uFF0C\u7E3D\u662F\u80FD\u5728\u6211\u4F4E\u6F6E\u6642\uFF0C\u975C\u975C\u5730\u966A\u4F34\u6211......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u8B93\u6211\u4E00\u500B\u4EBA\u4E5F\u4E0D\u5B64\u55AE\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u6211\u4E5F\u6700\u611B\u4F60\u4E86\uFF0C\u5E03\u840A\u514B\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5E03\u840A\u514B\uFF0C\u4F60\u7684\u8EAB\u9AD4......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
