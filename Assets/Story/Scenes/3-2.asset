      spriteIndex: 12
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5C31\u7B97\u518D\u9047\u5230\u4EC0\u9EBC\u56F0\u96E3\uFF0C\u6211\u4E5F\u6703\u70BA\u4E86\u4F60\u5531\u4E0B\u53BB\u7684\uFF01"
