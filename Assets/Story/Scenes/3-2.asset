    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 13
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u770B\u4F86\u6642\u9593\u4E5F\u5DEE\u4E0D\u591A\u4E86\u3002"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u840A\u83C8\uFF01\uFF01\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u80FD\u8B8A\u6210\u4F60\u7684\u5BB6\u4EBA\uFF0C\u662F\u6211\u9019\u4E00\u751F\uFF0C\u6700\u2014\u2014\u5E78\u904B\u7684\u4E00\u4EF6\u4E8B\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 17
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u840A\u62C9\u4E0D\u8981\u518D\u70BA\u4E86\u6211\u7684\u4E8B\u5167\u759A\uFF0C\u8D95\u5FEB\u6253\u8D77\u7CBE\u795E\u4F86\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u6211\u6703\u6C38\u9060\u5728\u4E00\u65C1\u5B88\u8B77\u840A\u83C8\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u6240\u4EE5\u8981\u4E0D\u65B7\u5805\u6301\u59B3\u7684\u5922\u60F3\u5594\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u56E0\u70BA\u6211\u60F3\u4E00\u76F4\u807D\u59B3\u5531\u6B4C\uFF01\u563F\u563F\u563F\uFF5E"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions: []
    timline: []
  - text: "\u90A3\u6709\u4EC0\u9EBC\u554F\u984C\uFF0C\u6211\u7B54\u61C9\u4F60\uFF0C\u5E03\u840A\u514B\u3002"
