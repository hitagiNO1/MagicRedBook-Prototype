      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u5E03\u840A\u514B\u775C\u5927\u96D9\u773C\uFF0C\u50CF\u89C0\u5BDF\u7375\u7269\u822C\u7684\u8DB4\u5728\u4E00\u65C1\uFF0C\u6E96\u5099\u7A81\u8972\u3002)"
