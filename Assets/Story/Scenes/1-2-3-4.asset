    timline:
    - animation: 1
      myPlayableAsset: {fileID: 11400000, guid: 5a7ac38efec157740a59f11917cbf186, type: 2}
      timing: 0
  - text: "(\u840A\u83C8\u5C07CD\u9084\u7D66\u96A8\u8EAB\u807D\uFF0C\u96A8\u8EAB\u807D\u5C07\u5B83\u7684\u5BF6\u8C9DCD\u6536\u5165\u56CA\u4E2D)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u6ECB\uFF0D\u6ECB\u6ECB\uFF0D\u6279\u54E9\u556A\u5566\uFF5E\u561F\u5695\u5695\u5695\u5695\u5695"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 5
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u5169\u96BB\u8001\u864E \uFF5E \u5169\u96BB\u8001\u864E \uFF5E \u8DD1\u5F97\u5FEB\uFF0C\u8DD1\u5F97\u5FEB\uFF5E\u3000\u266A"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 4
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u54C8\u54C8\u54C8\uFF5E\u9019\u662F\u4EC0\u9EBC\u5947\u602A\u7684\u6B4C\uFF01"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 0
      actionType: 4
      coords: {x: 0, y: 0}
      Right: 0
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 3
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8\uFF5E"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u9019\u662F\u7CBE\u9078\u540D\u5BB6\u4F73\u4F5C\uFF0C\u591A\u9996\u81BE\u7099\u4EBA\u53E3\u7684\u7D93\u5178\u5152\u6B4C\uFF0C\u5167\u5BB9\u5341\u5206\u8C50\u5BCC\u7684\uFF0D\u5152\u6B4C300\u9996\uFF01"
    speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: 6d65ca3567e5ffb4d8c65f1f12eb00da, type: 2}
      spriteIndex: 6
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u5169\u96BB\u8001\u864E\u554A\uFF0C\u597D\u61F7\u5FF5\u2026\u2026\u6211\u5C0F\u6642\u5019\u7761\u524D\u4E5F\u5F88\u5E38\u807D\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 12
      actionType: 4
      coords: {x: 0, y: 0}
      Right: 0
    - speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
      spriteIndex: 3
      actionType: 5
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4E0D\u77E5\u9053\u4E0A\u6B21\u807D\u5230\uFF0C\u662F\u4EC0\u9EBC\u6642\u5019\u4E86\u2026\u2026"
