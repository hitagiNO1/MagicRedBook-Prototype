      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u5225\u7DCA\u5F35\u5566\uFF0C\u6211\u5011\u4E0D\u662F\u602A\u7269\uFF0C\u53EA\u662F\u807D\u5230\u4F60\u5728\u558A\u2026\u2026\u6240\u4EE5\u904E\u4F86\u770B\u770B\u60C5\u6CC1\u3002"
