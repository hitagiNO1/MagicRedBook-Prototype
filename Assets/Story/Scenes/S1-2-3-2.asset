      spriteIndex: 16
      actionType: 1
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6211\u2026\u2026\u6211\u628A\u6211\u7684\u5BF6\u8C9D\u5011\u5F04\u4E1F\u4E86\uFF0C\u6211\u7684CD\u5011\u2026\u2026\u4ED6\u5011\u90FD\u4E0D\u898B\u4E86\u2026\u2026\uFF01"
