      spriteIndex: 5
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u6211\u7684\u6545\u9109\u2500\u2500\u8C93\u4E4B\u570B\uFF0C\u6B63\u9762\u81E8\u8457\u56B4\u91CD\u7684\u98E2\u8352\u2026\u2026\u6211\u5E0C\u671B\u59B3\u80FD\u5E6B\u5E6B\u6211\u5011\uFF01"
