    - speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
      spriteIndex: 16
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 1
    timline: []
  - text: "\u4E0D\u77E5\u9053\u5F9E\u4EC0\u9EBC\u6642\u5019\u958B\u59CB\uFF0C\u59B3\u5C31\u4E00\u76F4\u6C89\u7761\u5728\u9019\u6B64\uFF0C\u81F3\u65BC\u9019\u88E1......\u6211\u4E5F\u4E0D\u6E05\u695A\uFF0C\u597D\u50CF\u662F\u6211\u5011\u8AA4\u6253\u8AA4\u649E\u559A\u9192\u4E86\u59B3......"
    speaker: {fileID: 11400000, guid: e1c953448bc2f584ba07644c7d06769b, type: 2}
