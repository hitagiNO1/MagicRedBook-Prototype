  - text: "\u5C0D\u5440\uFF01\u90A3\u4F4D\u50B3\u8AAA\u4E2D\u80FD\u7528\u9B54\u6CD5\u7D05\u66F8\u7684\u529B\u91CF\u5275\u9020\u5947\u8E5F\u7684\u300E\u516C\u4E3B\u300F"
