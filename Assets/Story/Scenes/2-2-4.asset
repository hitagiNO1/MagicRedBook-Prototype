  sentences:
  - text: "\u54C8\u54C8\u54C8\u54C8\u54C8\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 11
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5E03\u840A\u514B\uFF01\uFF01\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u4F60\u770B\uFF0C\u9019\u662F\u6211\u4EBA\u751F\u4E2D\u7B2C\u4E00\u628A\u5409\u4ED6\u554A\uFF01\uFF01\uFF01"
    speaker: {fileID: 0}
    actions: []
    timline: []
  - text: "\u54C8\u54C8\u54C8\u54C8\u54C8\uFF01\u8D85\u7D1A\u958B\u5FC3\u7684\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u9019\u53EF\u662F\u6211\u6BCF\u5929\u653E\u5B78\u5F8C\u53BB\u706B\u934B\u5E97\u6253\u5DE5\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u7D2F\u5F97\u8981\u6B7B\u8981\u6D3B\uFF0C\u8F9B\u8F9B\u82E6\u82E6\u5B58\u4E0B\u4F86\u7684\u8840\u6C57\u9322\u8CB7\u7684\u554A\uFF01\uFF01\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u5FEB\u9EDE\u8A87\u6211\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "......\u55B5\u3002"
    speaker: {fileID: 11400000, guid: 99a7a061a13d5544998fdf3ccbd5365e, type: 2}
    actions: []
    timline: []
  - text: "\u54C8\u54C8\u54C8\uFF5E\u5E03\u840A\u514B\uFF0C\u4F60\u6700\u6367\u5834\u4E86\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 10
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u7576\u521D\u8D70\u9032\u6A02\u5668\u884C\uFF0C\u7B2C\u4E00\u773C\u5C31\u76F8\u4E2D\u5B83\u4E86\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u9023\u4FDD\u990A\u7528\u7684\u6E05\u6F54\u881F\u6211\u90FD\u8CB7\u4E86\uFF0C\u7B49\u7B49\u8981\u5E6B\u5B83\u597D\u597D\u64E6\u4E00\u64E6\uFF5E"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "(\u840A\u83C8\u8F15\u8F15\u64A5\u52D5\u4E86\u5E7E\u4E0B\u7434\u5F26\uFF0C\u5409\u4ED6\u767C\u51FA\u6E05\u8106\u7684\u8072\u97FF\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u54C7\u554A\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 11
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: ......
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u5E03\u840A\u514B\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u6211\u89BA\u5F97\u554A\u2026\u2026\u6211\u597D\u50CF\uFF0C\u771F\u7684\u5F80\u5922\u60F3\u66F4\u8FD1\u4E86\u4E00\u6B65\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 10
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "......\u55B5\uFF01"
    speaker: {fileID: 11400000, guid: 99a7a061a13d5544998fdf3ccbd5365e, type: 2}
    actions: []
    timline: []
  - text: "\u54C8\u54C8\u54C8\uFF5E"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u4F60\u53EF\u662F\u6211\u7B2C\u4E00\u500B\u807D\u773E\u5462\uFF0C\u5E03\u840A\u514B\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 10
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u554A\uFF01\u5982\u679C\u5E36\u8457\u4E00\u96BB\u9ED1\u8C93\u4E00\u8D77\u81EA\u5F48\u81EA\u5531\u2026\u2026\u597D\u50CF\u5F88\u6709\u770B\u982D\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u61C9\u8A72\u80FD\u5438\u5F15\u8D85\u591A\u89C0\u773E\u5427\uFF5E"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u54C8\u54C8\u54C8\uFF5E\u90A3\u5E03\u840A\u514B\u4F60\u8981\u7576\u7B2C\u4E8C\u4E3B\u5531\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 11
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u53EA\u8981\u5728\u65C1\u908A\u55B5\u55B5\u53EB\u5C31\u597D\u4E86\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u6211\u5011\u5C31\u53EB\u2014\u2014\u9ED1\u8C93\u6A02\u5718\uFF01"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 10
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "......\u55B5\u55DA\uFF1F"
    speaker: {fileID: 11400000, guid: 99a7a061a13d5544998fdf3ccbd5365e, type: 2}
    actions: []
    timline: []
  - text: "\u54C8\u54C8\u54C8\uFF5E\u5C0D\u5C0D\u5C0D\uFF0C\u5C31\u662F\u9019\u6A23\uFF01\u5E03\u840A\u514B\u597D\u68D2\u54E6\uFF5E"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
