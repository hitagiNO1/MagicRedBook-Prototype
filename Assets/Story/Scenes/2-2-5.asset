  m_EditorClassIdentifier: 
  StopMove: 0
  sentences:
  - text: "\u2026\u2026\u56DB\u5341\u4E5D\u5206\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 9
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5509\u2026\u2026\u53C8\u4E0D\u53CA\u683C\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "(\u8003\u5377\u4E0A\u6EFF\u6EFF\u7684\u7D05\u53C9\uFF0C\u5206\u6578\u88AB\u5927\u5927\u5730\u5708\u8D77\uFF0C\u50CF\u4E00\u8A18\u91CD\u64CA)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u518D\u904E\u5169\u9031\u5C31\u6A21\u64EC\u8003\u4E86\uFF0C\u9019\u7A2E\u6210\u7E3E\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 8
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5982\u679C\u8003\u5DEE\u4E86\uFF0C\u7238\u5ABD\u4E0D\u77E5\u9053\u53C8\u6703\u505A\u51FA\u751A\u9EBC\u4E8B\u4F86......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u4E0A\u6B21\u2026\u2026\u5C31\u56E0\u70BA\u9019\u6A23\uFF0C\u8DDF\u4ED6\u5011\u5927\u5435\u4E00\u67B6\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u7238\u7238\u4E00\u6C23\u4E4B\u4E0B\uFF0C\u9023\u5409\u4ED6\u90FD\u2026\u2026\u6454\u4E86\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u8AAA\u4EC0\u9EBC\u300E\u9019\u7A2E\u5206\u6578\uFF0C\u9084\u6709\u81C9\u73A9\u5409\u4ED6\uFF1F\u300F\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u679C\u7136\u2026\u2026\u97F3\u6A02\u3001\u5922\u60F3\uFF0C\u9019\u4E9B\u6771\u897F\uFF0C\u5728\u5927\u4EBA\u773C\u88E1\uFF0C\u6839\u672C\u4E00\u6587\u4E0D\u503C\u5427\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 9
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u4ED6\u5011\u53EA\u5728\u4E4E\u5206\u6578\uFF0C\u53EA\u5728\u4E4E\u5347\u5B78\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 8
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6211\u6C92\u6709\u2026\u2026\u4E0D\u52AA\u529B\u554A\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u6211\u53EA\u662F\u2026\u2026\u53EA\u662F\u60F3\u505A\u6211\u559C\u6B61\u7684\u4E8B\u800C\u5DF2\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 9
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u5347\u5B78\u7684\u58D3\u529B\u3001\u5BB6\u5EAD\u7684\u5426\u5B9A\uFF0C\u50CF\u5DE8\u77F3\u4E00\u6A23\u58D3\u5F97\u5979\u5598\u4E0D\u904E\u6C23\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "......\u55B5\u3002"
    speaker: {fileID: 11400000, guid: 99a7a061a13d5544998fdf3ccbd5365e, type: 2}
    actions: []
    timline: []
  - text: "\u4F60\u4E5F\u89BA\u5F97\u6211\u5F88\u6C92\u7528\u5427\uFF1F"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 8
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u55B5\u3002"
    speaker: {fileID: 11400000, guid: 99a7a061a13d5544998fdf3ccbd5365e, type: 2}
    actions: []
    timline: []
  - text: "\u2026\u2026\u4E5F\u662F\u5462\uFF0C\u7684\u78BA\u662F\u5F88\u6C92\u7528\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 9
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u597D\u50CF\u2026\u2026\u4E00\u76F4\u90FD\u53EA\u662F\u52C9\u5F37\u6490\u8457\u800C\u5DF2\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 8
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u5FF5\u66F8\u662F\u9019\u6A23\uFF0C\u7DF4\u5409\u4ED6\u4E5F\u662F\u9019\u6A23\u2026\u2026"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "(\u5E03\u840A\u514B\u5074\u8EBA\u5728\u8A66\u5377\u4E0A\uFF0C\u50CF\u662F\u6545\u610F\u64CB\u4F4F\u90A3\u4E9B\u4EE4\u4EBA\u7A92\u606F\u7684\u6587\u5B57\u8207\u5206\u6578\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 9
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u55B5\u55DA\uFF01"
    speaker: {fileID: 11400000, guid: 99a7a061a13d5544998fdf3ccbd5365e, type: 2}
    actions: []
    timline: []
  - text: "\u2026\u2026\u4F60\u554A\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 8
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "(\u840A\u83C8\u62AC\u8D77\u624B\uFF0C\u8F15\u8F15\u64AB\u6478\u5E03\u840A\u514B\u7684\u982D\uFF0C\u611F\u53D7\u5230\u6307\u5C16\u50B3\u4F86\u7684\u6EAB\u6696\u8207\u5FAE\u5FAE\u7684\u986B\u52D5\u3002)"
    speaker: {fileID: 11400000, guid: 755db819ff1a2ea4aa12594b5b3997b8, type: 2}
    actions: []
    timline: []
  - text: "\u547C\u5695\u2014\u2014\u2014\u547C\u5695\u5495\u5695\u3002"
    speaker: {fileID: 11400000, guid: 99a7a061a13d5544998fdf3ccbd5365e, type: 2}
    actions: []
    timline: []
  - text: "\u7E3D\u662F\u51FA\u73FE\u5728\u6211\u5FEB\u8981\u6490\u4E0D\u4F4F\u7684\u6642\u5019......"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u7D66\u4E86\u6211\u6490\u4E0B\u53BB\u7684\u52C7\u6C23\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u8B1D\u8B1D\u4F60......\u5E03\u840A\u514B\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions:
    - speaker: {fileID: 11400000, guid: f3fdb2924f94d2742ae390dbb0d250da, type: 2}
      spriteIndex: 7
      actionType: 0
      coords: {x: 0, y: 0}
      Right: 0
    timline: []
  - text: "\u6211\u6703\u518D\u8A66\u8A66\u770B\u7684\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  - text: "\u81F3\u5C11\u2026\u2026\u9084\u6709\u4F60\u5728\u3002"
    speaker: {fileID: 11400000, guid: ba40ea94def04444582a484795b61ca1, type: 2}
    actions: []
    timline: []
  nextScene: {fileID: 0}
